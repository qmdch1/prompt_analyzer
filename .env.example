# Runtime
APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=info,tower_http=info

# Internal Docker endpoints (use localhost equivalents when running Rust on the host)
DATABASE_URL=postgres://prompt:prompt@postgres:5432/prompt_analyzer
REDIS_URL=redis://redis:6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=prompt-analyzer-v1
KAFKA_TOPICS=promptdb.public.prompt_runs,promptdb.public.evaluations

# PostgreSQL / Debezium
POSTGRES_DB=prompt_analyzer
POSTGRES_USER=prompt
POSTGRES_PASSWORD=prompt
DEBEZIUM_DATABASE_HOSTNAME=postgres
DEBEZIUM_DATABASE_PORT=5432
DEBEZIUM_DATABASE_USER=prompt
DEBEZIUM_DATABASE_PASSWORD=prompt
DEBEZIUM_DATABASE_DBNAME=prompt_analyzer
DEBEZIUM_TOPIC_PREFIX=promptdb

# AI is disabled by default. Set both values to enable POST /v1/runs/:id/execute.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# USD per one million tokens. Keep pricing configuration outside source code.
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
