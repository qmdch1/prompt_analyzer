# 모두 선택 사항입니다. 비워두면 기본값으로 동작합니다.

# 로컬에서 `cargo run` 할 때 쓰는 DB 주소 (docker compose 는 자동 설정)
DATABASE_URL=postgres://prompt:prompt@localhost:5432/prompt_analyzer
PORT=8080
RUST_LOG=info

# 키를 넣으면 POST /v1/runs/:id/execute 로 AI를 직접 호출합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 100만 토큰당 USD 가격 (비용 계산용)
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
